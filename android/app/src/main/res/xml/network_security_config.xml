<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 审计 F2 修复（2026-10-03）：删掉 fwq.pw0769.site 的明文放行。
         该域名是历史遗留死配置，全站已走 HTTPS，保留它等于给中间人留一个可降级的入口。 -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- 调试面板用：本机 / 模拟器宿主 / 局域网常用地址（仅配合调试面板的自定义服务器地址，
         不影响官方线路）。
         ⚠️ Android 的 domain-config 只能写**具体主机名**，不支持 CIDR / 通配 IP 段。
         要指向别的局域网 IP，把 IP 加到下面的列表里（本地改一处，四步验证不用重跑）。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>    <!-- 模拟器映射到宿主机 -->
        <domain includeSubdomains="false">10.0.3.2</domain>    <!-- Genymotion 宿主 -->
        <domain includeSubdomains="false">10.0.2.1</domain>    <!-- 模拟器网关 -->
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.1.100</domain>
        <domain includeSubdomains="false">192.168.1.5</domain>
        <domain includeSubdomains="false">192.168.31.1</domain>
        <domain includeSubdomains="false">192.168.43.1</domain>
        <domain includeSubdomains="false">172.16.0.1</domain>
        <domain includeSubdomains="false">0.0.0.0</domain>
    </domain-config>
</network-security-config>
